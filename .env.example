# ── Core ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sgela
NEXT_PUBLIC_APP_DOMAIN=sgela.veza.africa
LOG_LEVEL=info

# ── Database (docker compose: pnpm db:up) ─────────────
DATABASE_URL=postgresql://sgela:sgela@localhost:5432/sgela
REDIS_URL=redis://localhost:6379

# ── Auth (M1) ────────────────────────────────────────
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
HASH_SALT=change-me
# Phone OTP limits (L-ON-2). Defaults: 5 sends/hour/number, 20/hour/IP.
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20
# Bearer secret for POST /api/cron/guardian-reminders (scheduler calls it every 15 min).
CRON_SECRET=change-me
# Expose /api/dev/sms-outbox under `next start` (console SMS provider only; e2e).
ENABLE_SMS_OUTBOX=0

# ── Observability (M0-5) ─────────────────────────────
# Leave blank to disable Sentry locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Provider flags: console | real vendor (M1+/M8) ───
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
STORAGE_PROVIDER=local
IDENTITY_PROVIDER=manual
SPEECH_PROVIDER=none
PAYMENTS_PROVIDER=none
EMBEDDING_PROVIDER=none

# ── AI Coach (M6) ────────────────────────────────────
COACH_LLM_PROVIDER=console
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5
COACH_ROUTER_MODEL=claude-haiku-5-5

# ── Analytics (optional) ─────────────────────────────
POSTHOG_KEY=
POSTHOG_HOST=
